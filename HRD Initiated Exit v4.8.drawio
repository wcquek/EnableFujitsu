 cleared&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;[Autopopulate, but editable]&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Division&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Department&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Section&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Domain&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Designation&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Reporting Officer&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Staff Categories&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;PA (show If Staff categories = POH, PS, DS, LG, HOD)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Principals Supported by PA &lt;i&gt;(show and mandatory If Staff categories = PA, Helptext: Select the director(s) that the new Personal Assistant (PA) will support. You may choose multiple directors if the PA will assist more than one.)&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Staff Categories for asset assignment&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Cat 2 (By submitting this form, I declare that this new hire has been Cat 2 cleared.&#39;)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Pension [Checkbox] -&amp;gt; &lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(18, 18, 18)); background-color: transparent;&quot;&gt;CMD -&amp;gt; Employees under Pension can retain PS Card.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(18, 18, 18));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(18, 18, 18));&quot;&gt;Statutory Appointment&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(18, 18, 18));&quot;&gt;(Designation based, &lt;span style=&quot;background-color: transparent;&quot;&gt;Name based, &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;No Statutory Appointment)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(18, 18, 18));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(51, 0, 0), rgb(18, 18, 18));&quot;&gt;Concurrent Statutory Appointment&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;[set of 2nd appointment details]&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Assignment Group = HRD Hub Exit&lt;/div&gt;" vertex="1">
